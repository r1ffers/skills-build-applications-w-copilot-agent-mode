# OctoFit Tracker - Frontend Environment Configuration
# 
# REQUIRED: Set VITE_CODESPACE_NAME to your GitHub Codespace name
# This is used to construct the API base URL for Codespaces deployments
# 
# Example: If your Codespace name is "supreme-memory-759rwv6qj6vfw5xq",
# the API will be accessed at: https://supreme-memory-759rwv6qj6vfw5xq-8000.app.github.dev
#
# To find your Codespace name:
# 1. Look at your Codespace URL in the browser address bar
# 2. Extract the name before "-5173.app.github.dev"
# 3. Set it here as VITE_CODESPACE_NAME

VITE_CODESPACE_NAME=your-codespace-name-here

# Optional: API base URL fallback for local development
# If not set, defaults to http://localhost:8000
# VITE_API_BASE_URL=http://localhost:8000
